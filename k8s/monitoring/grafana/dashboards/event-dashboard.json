{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["event-service", "eventticketing", "logql", "promql"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Event Service Dashboard",
  "uid": "event-service-dashboard",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Error Rate (errors per minute)",
      "description": "Count of ERROR-level log lines from event-service per minute.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"eventticketing\", service=\"event-service\", level=\"ERROR\"} | json [1m]))",
          "legendFormat": "errors/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Read Endpoint Activity (Slice 4)",
      "description": "Tracks logs related to the two S2-READ-DB endpoints: avg-capacity and venue-coords.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"eventticketing\", service=\"event-service\"} | json | message =~ \".*avg.*capacity.*|.*Average.*capacity.*\" [5m]))",
          "legendFormat": "avg-capacity reads",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({app=\"eventticketing\", service=\"event-service\"} | json | message =~ \".*venue.*coords.*|.*Venue.*coordinates.*\" [5m]))",
          "legendFormat": "venue-coords reads",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "Feign Call Outcomes (Slice 5)",
      "description": "Successful Feign responses vs FeignException catches.",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(count_over_time({app=\"eventticketing\", service=\"event-service\"} | json | message =~ \".*reachable.*\" [5m]))",
          "legendFormat": "Feign success",
          "refId": "A"
        },
        {
          "expr": "sum(count_over_time({app=\"eventticketing\", service=\"event-service\"} | json | message =~ \".*unavailable.*|.*Feign.*failed.*|.*temporarily unavailable.*\" [5m]))",
          "legendFormat": "Feign failures",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Observer Event Audit",
      "description": "INDEXED, EVENT_STATUS_UPDATED, SESSION_VERIFIED, DASHBOARD_VIEWED actions.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "{app=\"eventticketing\", service=\"event-service\"} |~ \"INDEXED|EVENT_STATUS_UPDATED|SESSION_VERIFIED|DASHBOARD_VIEWED\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Request Rate (req/s)",
      "description": "Requests per second to event-service endpoints, grouped by method and URI.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by(method, uri) (rate(http_server_requests_seconds_count{job=\"event-service\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Latency (P50/P95/P99)",
      "description": "Request latency percentiles for event-service endpoints.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by(le, uri) (rate(http_server_requests_seconds_bucket{job=\"event-service\"}[5m])))",
          "legendFormat": "P50 {{uri}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by(le, uri) (rate(http_server_requests_seconds_bucket{job=\"event-service\"}[5m])))",
          "legendFormat": "P95 {{uri}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by(le, uri) (rate(http_server_requests_seconds_bucket{job=\"event-service\"}[5m])))",
          "legendFormat": "P99 {{uri}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "title": "JVM Heap Usage",
      "description": "JVM heap memory used by event-service over time.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=\"event-service\", area=\"heap\"}",
          "legendFormat": "heap used",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{job=\"event-service\", area=\"heap\"}",
          "legendFormat": "heap max",
          "refId": "B"
        }
      ]
    }
  ]
}